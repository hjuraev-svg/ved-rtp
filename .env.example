# Copy to .env and adjust. docker compose reads .env automatically.

# --- Ports on your machine ---
# 8080 is taken by another container on this host; 8090 is known free.
WEB_PORT=8090
API_PORT=8000
POSTGRES_PORT=5433

# --- Database ---
POSTGRES_USER=ved
POSTGRES_PASSWORD=ved_local_pass
POSTGRES_DB=ved

# --- Security ---
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env-file

# --- Bootstrap admin (created on first start only) ---
ADMIN_EMAIL=admin@ved.local
ADMIN_PASSWORD=admin123

# --- Demo data ---
# false = clean database, only the ADMIN_* account above.
# true  = 24 sample deals, 6 suppliers and demo users (password demo123).
# Changing this only takes effect on an empty database: docker compose down -v
SEED_DEMO=false

TZ=Asia/Tashkent

# --- Gmail + Telegram (one mailbox and one bot) ---
# Create this key once and keep it private:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Google Cloud OAuth Web client. Add the callback URL below to its authorized
# redirect URIs. For a public deployment, set PUBLIC_BASE_URL to its HTTPS URL.
PUBLIC_BASE_URL=http://localhost:8090
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: by default it is $PUBLIC_BASE_URL/api/integrations/gmail/callback
GMAIL_REDIRECT_URI=
# 0 = manual-only; default 5 checks Inbox every five minutes while the stack runs.
GMAIL_POLL_INTERVAL_MINUTES=5
# Create a bot with @BotFather. Telegram sends incoming updates to
# $PUBLIC_BASE_URL/api/integrations/telegram/webhook/$TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
